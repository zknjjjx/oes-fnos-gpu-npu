#!/bin/bash
# 安装前检查：架构与内核驱动（GPU: panfrost/mali_kbase，NPU: etnaviv/galcore，至少一个）
export PATH="$PATH:/sbin:/usr/sbin"
KV=$(uname -r)
if [ "$(uname -m)" != "aarch64" ]; then
  echo "仅支持 ARM64 (A311D) 设备" > "$TRIM_TEMP_LOGFILE"; exit 1
fi
has_module() {
  [ -d "/sys/module/$1" ] && return 0
  modinfo "$1" >/dev/null 2>&1 && return 0
  grep -qE "/$1\.ko" "/lib/modules/$KV/modules.builtin" 2>/dev/null && return 0
  [ -n "$(find "/lib/modules/$KV" -name "$1.ko*" 2>/dev/null | head -n1)" ]
}
for m in panfrost mali_kbase mali bifrost_kbase etnaviv galcore; do
  has_module "$m" && exit 0
done
echo "当前内核 $KV 没有任何 GPU/NPU 驱动（panfrost、mali_kbase、etnaviv、galcore 均未找到）" > "$TRIM_TEMP_LOGFILE"
exit 1
