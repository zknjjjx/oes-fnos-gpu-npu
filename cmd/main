#!/bin/bash
export PATH="$PATH:/sbin:/usr/sbin"
MODS=$(cat /etc/modules-load.d/oes-gpu-npu.conf 2>/dev/null)
case "$1" in
  start)  for m in $MODS; do modprobe "$m" 2>/dev/null; done; exit 0 ;;
  stop)   exit 0 ;;
  status) for m in $MODS; do [ -d "/sys/module/$m" ] && exit 0; done; exit 3 ;;
  *)      exit 1 ;;
esac
